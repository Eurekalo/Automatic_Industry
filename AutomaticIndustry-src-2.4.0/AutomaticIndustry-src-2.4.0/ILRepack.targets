<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="AfterBuildILRepack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(TargetDir)PLib.dll" />
      <InputAssemblies Include="$(TargetDir)ONI_Together_API.dll" Condition="Exists('$(TargetDir)ONI_Together_API.dll')" />
      <SearchDirectories Include="$(ONIManaged)" />
    </ItemGroup>
    <ILRepack
        Parallel="true"
        Internalize="true"
        InputAssemblies="@(InputAssemblies)"
        TargetKind="Dll"
        OutputFile="$(TargetPath)"
        LibraryPath="@(SearchDirectories)"
    />
  </Target>
</Project>
